{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "memoryloop",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "memoryloop"
  },
  "runtimes": [],
  "memories": [
    {
      "name": "episodicMem",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        }
      ]
    },
    {
      "name": "customMem",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [
    {
      "name": "extractor",
      "path": "app/extractor"
    },
    {
      "name": "extractor_ep",
      "path": "app/extractor_ep"
    },
    {
      "name": "extractor_ep_review",
      "path": "app/extractor_ep_review"
    },
    {
      "name": "extractor_ep_review_nomem",
      "path": "app/extractor_ep_review_nomem"
    }
  ],
  "datasets": [],
  "payments": []
}
